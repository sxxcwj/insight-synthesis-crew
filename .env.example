# 服务监听。默认只本机可访问。部署到服务器时把 HOST 改为 0.0.0.0。
HOST=127.0.0.1
PORT=8000

# 访问认证。APP_PASSWORD 与 ACCESS_TOKEN 至少设置一项后，页面和全部 /api 都需要登录。
# 两项都留空时是本机免登录模式，启动时会打印警告。不要把真实口令提交到仓库。
# APP_PASSWORD=
# ACCESS_TOKEN=

# 外发脱敏，默认开启。设为 false / off / 0 可关闭。
# 会在课题送去外部搜索和 DeepSeek 之前，把手机号、身份证号、邮箱、银行卡号，
# 以及下面列出的客户企业名称，替换成占位符。
REDACTION_ENABLED=true
# 多个名称用中文或英文逗号分隔。名单文件每行一个名称，# 开头为注释。不要提交真实客户名单。
# REDACTION_CLIENT_NAMES=示例客户制造有限公司,示例客户科技股份有限公司
# REDACTION_CLIENTS_FILE=config/clients.local.txt

# DeepSeek 模型与密钥。页面上的模型名来自这里，未填写时回退到 config/agents.yaml。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
SCOUT_LLM_MODEL=deepseek/deepseek-flash
ANALYST_LLM_MODEL=deepseek/deepseek-flash

# 可选搜索引擎（阶段一检索）。未配置时状态指示为红色，检索员仍可使用网页抓取工具。
SERPER_API_KEY=your_serper_api_key_here

# 其他备选模型提供商（如需要切换）
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
